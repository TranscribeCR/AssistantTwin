<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Assistant Twin"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Runs fully on-device. Each permission below is separate and opt-in -- nothing is enabled until you tap it."
            android:textSize="14sp"
            android:textColor="#555555"
            android:paddingBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Permissions"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <Button android:id="@+id/btnGrantAll" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="Grant everything (one flow)"
            android:backgroundTint="#4A6CF7" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Individual permissions" android:textStyle="bold" android:textSize="12sp" android:textColor="#888888" />

        <Button android:id="@+id/btnSms" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="Messages (SMS)" />

        <Button android:id="@+id/btnVoice" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="Voice (microphone)" />

        <Button android:id="@+id/btnContactsCalendar" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="Contacts + Calendar (read/write)" />

        <Button android:id="@+id/btnStorage" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="Photos, media &amp; files" />

        <Button android:id="@+id/btnAllFiles" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="All-files access (advanced)" />

        <Button android:id="@+id/btnNotifications" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="Notifications (background status)" />

        <Button android:id="@+id/btnExactAlarm" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="Exact alarms" />

        <Button android:id="@+id/btnUsageStats" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="See installed / running apps" />

        <Button android:id="@+id/btnAccessibility" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="Accessibility service (read/tap other apps)" />

        <Button android:id="@+id/btnStartService" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="Start Assistant Twin (background)" />

        <Button android:id="@+id/btnOpenChat" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="Open chat / voice control" />

        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
